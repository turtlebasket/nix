#!/usr/bin/env bash

# Keep a shared miscellaneous session rooted at home.
session="_misc"

cd "$HOME" || exit 1

if [[ -n "${TMUX:-}" ]]; then
    if ! tmux has-session -t "=$session" 2>/dev/null; then
        tmux new-session -d -s "$session" -c "$HOME" || exit 1
    fi
    exec tmux switch-client -t "=$session"
fi

if tmux has-session -t "=$session" 2>/dev/null; then
    exec tmux attach -t "=$session"
else
    exec tmux new -s "$session"
fi
